# Copy to `.env` on the server and fill real values.
# Never commit `.env`.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=ksajob

# Twice-daily scrape (Asia/Riyadh, UTC+3). Hours are comma-separated.
# Leave SCRAPE_KEYWORDS empty to pull a default set of roles. A comma list matches ANY keyword (OR).
SCRAPE_SCHEDULE_ENABLED=true
SCRAPE_TZ=Asia/Riyadh
SCRAPE_HOURS=8,20
SCRAPE_KEYWORDS=
SCRAPE_STATE=All
SCRAPE_PLATFORM=All
SCRAPE_CITY=
