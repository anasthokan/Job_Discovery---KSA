# Copy to `.env` on the server and fill real values.
# Never commit `.env`.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=ksajob

# Twice-daily scrape (Asia/Riyadh, UTC+3). Hours are comma-separated.
# Leave SCRAPE_KEYWORDS empty. An empty value is ignored.
# The scrape then searches skills and certifications stored in MySQL.
# A comma list, if you set one, matches ANY keyword (OR).
SCRAPE_SCHEDULE_ENABLED=true
SCRAPE_TZ=Asia/Riyadh
SCRAPE_HOURS=8,20
SCRAPE_TARGET=5000
SCRAPE_KEYWORDS=
SCRAPE_STATE=All
SCRAPE_PLATFORM=All
SCRAPE_CITY=

# Dev Global Jobs display API. One pull per minute. Full posting text is saved in jobs.
# Keep their job links, and show "Powered by Dev Global Jobs" where these listings appear.
GLOBALJOBS_ENABLED=true
GLOBALJOBS_COUNTRY=sa
GLOBALJOBS_INTERVAL_MINUTES=1

# Headcount Labs career-page jobs for Saudi Arabia. Free tier only.
# 100,000 records per UTC month. The same job delivered again counts again.
# Never enable paid usage. Leave the key empty to keep this feed off.
# Sync lists current SA jobs once, then only rows changed since the last watermark.
# It does not call the global changes feed. Pulls stop at HEADCOUNT_RECORD_CAP.
HEADCOUNT_ENABLED=true
HEADCOUNT_API_KEY=
HEADCOUNT_COUNTRY=SA
HEADCOUNT_INTERVAL_MINUTES=60
HEADCOUNT_RECORD_CAP=95000
HEADCOUNT_MAX_PULL=30000
HEADCOUNT_FULL_REFRESH_DAYS=7

# Greenhouse, Lever, SmartRecruiters, and Workday company boards.
# These are not a country-wide search. The feed keeps Saudi locations only.
ATS_BOARDS_ENABLED=true
ATS_BOARDS_INTERVAL_MINUTES=360

# WhatsApp alert when a newly saved job matches a user's recommendations.
# Same matcher as /api/recommend. One message per job, any ingest source.
WHATSAPP_ALERTS=true
# Full send URL, or just the host (the session path is added).
WHATSAPP_API_URL=http://74.208.184.175:8000/sessions/Intellirestro/send-message
# Sent as the X-API-Key header. The gateway answers 401 without it.
WHATSAPP_API_KEY=
WHATSAPP_API_KEY_HEADER=x-api-key
WHATSAPP_MIN_SCORE=1
WHATSAPP_DEBOUNCE_SECONDS=30
WHATSAPP_MAX_PER_FLUSH=30
# 0 sends every matching job. A positive number stops that user after that many texts in a day.
WHATSAPP_MAX_PER_DAY=0

# Recommendation weights and the match cutoff, from the deployed KsaJob API.
# Weights: GET /api/v1/admin/portal/recommendation-score/?active=true
# Cutoff:  GET /api/v1/scores/  (the lowest stored score)
# The token needs the jobs console permission. Leave both auth lines empty to
# keep the built-in split: skills 55, certifications 15, title 20, years/level 10, cutoff 25.
KSAJOBS_API_BASE=https://ksajobs-apis.atozeesolutions.com
KSAJOBS_ACCESS_TOKEN=
KSAJOBS_API_EMAIL=
KSAJOBS_API_PASSWORD=
